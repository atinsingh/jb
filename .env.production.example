# Jobocate production source of truth. Copy to .env.production and replace all
# placeholder values. The deploy script splits browser-public NEXT_PUBLIC_*
# values from backend-only values before building the two images.
NODE_ENV=production
PORT=8000
MONGODB_URI=mongodb+srv://user:password@host/jobocate
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_WEBHOOK_SECRET=replace-me
NEXT_PUBLIC_API_URL=https://jobocate.pragra.io
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
FRONTEND_URL=https://jobocate.pragra.io
RESUME_SHARE_SECRET=replace-me
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_MASTER_KEY=replace-me
RESUME_HARNESS_LITELLM_KEY=replace-me
RESUME_SANDBOX_DRIVER=agent-platform
AGENT_PLATFORM_URL=https://agents.example.com
AGENT_PLATFORM_API_KEY=replace-me
RESUME_SANDBOX_IMAGE=registry.digitalocean.com/perfectum/jobocate-resume-harness:replace-me
RESUME_SANDBOX_TTL_SECONDS=900
DEFAULT_AUTOMATIC_MODEL_ALIAS=anthropic/claude-sonnet-4-6/low
CANDIDATE_ATS_MAX_REVIEW_TURNS=3
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
LOG_LEVEL=info
SWAGGER_ENABLED=false
STORAGE_DRIVER=s3
S3_BUCKET=jobocate
S3_REGION=your-supabase-project-region
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/jobocate
S3_SIGNED_URL_TTL=3600
QUEUE_ENABLED=false
# Supabase Postgres session-pooler URI, including encoded password and sslmode=require.
LITELLM_DATABASE_URL=
