# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (auth).
#
# ONLY these two Supabase vars belong on the frontend. The anon key is public by
# design and safe in the browser bundle; the SERVICE-ROLE key bypasses all
# authorisation and must never be given a NEXT_PUBLIC_ prefix or placed in this
# file — it lives in backend/env.example only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
