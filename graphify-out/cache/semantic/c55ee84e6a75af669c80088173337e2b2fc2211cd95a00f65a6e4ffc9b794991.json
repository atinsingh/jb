{"nodes": [{"id": "phase1_implementation_ai_service_module", "label": "AI Service Module (/src/ai-service)", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 8-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configurable AI provider support chosen explicitly for cost optimization \u2014 a unified interface over OpenAI/Anthropic/Google means the provider can be swapped by env var with no code change. Exposes parseResume, calculateJobMatch and generateCoverLetter."}, {"id": "phase1_implementation_resume_parser_module", "label": "Resume Parser Module (/src/resume-parser)", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 34-61, 241-246", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PDF/DOCX upload (5MB cap) -> validate and store (local or S3 via STORAGE_TYPE) -> extract text -> AI parse into structured data -> auto-update user profile. Dual local/S3 storage keeps local dev dependency-free while allowing encrypted S3 in production."}, {"id": "phase1_implementation_job_scraper_module", "label": "Job Scraper Module (/src/job-scraper)", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 64-109, 248-252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web scrapes Indeed with LinkedIn/Glassdoor ready for API integration; duplicates prevented via a unique externalId; rate limiting configurable per job board and robots.txt respected. Production guidance is to prefer official APIs over scraping."}, {"id": "phase1_implementation_scrapedjob_schema", "label": "ScrapedJob Schema", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 91-109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "title, companyName, location, description, skills[], requirements[], salary, jobType, experience, source (LinkedIn|Indeed|Glassdoor), externalUrl, externalId (unique), isActive, scrapedAt. externalId uniqueness is the deduplication key across repeated scrapes."}, {"id": "phase1_implementation_job_matching_module", "label": "Job Matching Module (/src/job-matching)", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 113-155, 254-258", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computes match score with AI, tracks matched/missing skills and reasoning, supports marking interest, and generates recommendations. Persisting matches in the jobmatches collection makes the expensive AI call a one-time cost per user-job pair."}, {"id": "phase1_implementation_jobmatch_schema", "label": "JobMatch Schema", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 142-155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "userId, jobId, matchScore (0-100), matchedSkills[], missingSkills[], reasoning, isInterested, isApplied, matchedAt \u2014 the join entity between users and scraped jobs."}, {"id": "phase1_implementation_application_agent_module", "label": "Application Agent Module (/src/application-agent)", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 159-211, 260-266", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queue-based rather than synchronous: interest -> queue -> agent generates cover letter with AI -> ready for submission, with QUEUED/PROCESSING/COMPLETED/FAILED states, retryCount and batch processing on APPLICATION_AGENT_INTERVAL (30 min). Queueing decouples the slow AI generation from the user request and makes failures retryable. Disabled by default."}, {"id": "phase1_implementation_agentapplication_schema", "label": "AgentApplication Schema", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 196-211", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "userId, jobId, status (QUEUED|PROCESSING|COMPLETED|FAILED), generatedCoverLetter, resumeUrl, queuedAt/processedAt/completedAt, errorMessage, retryCount, applicationData."}, {"id": "phase1_implementation_user_schema_extension", "label": "Extended User Schema (Candidate Profile)", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 215-235", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds phone, skills[], experience[{company, position, duration, description}], education[{institution, degree, year}], certifications[] and resumeUrl so resume parsing can auto-populate the profile in place rather than in a separate entity."}, {"id": "phase1_implementation_dependencies", "label": "Phase 1 Dependency Set", "file_type": "concept", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 352-374", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "openai / @anthropic-ai/sdk / @google/generative-ai for AI; pdf-parse and mammoth for PDF/DOCX text extraction; axios + cheerio (+ optional puppeteer) for scraping; aws-sdk and multer-s3 for S3 storage; node-cron for scheduling."}, {"id": "phase1_implementation_storage_strategy", "label": "Dual Local/S3 Resume Storage Strategy", "file_type": "rationale", "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 44-54, 395-399", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "STORAGE_TYPE switches between local filesystem (LOCAL_STORAGE_PATH) and S3 (AWS_REGION/ACCESS_KEY/SECRET/BUCKET). Local keeps dev setup trivial; S3 gives encrypted, durable storage in production. Uploads are constrained to 5MB and PDF/DOCX only."}], "edges": [{"source": "phase1_implementation_resume_parser_module", "target": "phase1_implementation_ai_service_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 28-29, 38-40", "weight": 1.0}, {"source": "phase1_implementation_job_matching_module", "target": "phase1_implementation_ai_service_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 29-30, 116-118", "weight": 1.0}, {"source": "phase1_implementation_application_agent_module", "target": "phase1_implementation_ai_service_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 30-31, 163-165, 263", "weight": 1.0}, {"source": "phase1_implementation_resume_parser_module", "target": "phase1_implementation_user_schema_extension", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 41-42, 215-235, 245-246", "weight": 1.0}, {"source": "phase1_implementation_resume_parser_module", "target": "phase1_implementation_storage_strategy", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 41-54", "weight": 1.0}, {"source": "phase1_implementation_job_scraper_module", "target": "phase1_implementation_scrapedjob_schema", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 91-109", "weight": 1.0}, {"source": "phase1_implementation_job_matching_module", "target": "phase1_implementation_jobmatch_schema", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1_IMPLEMENTATION.md", "source_location": "lines 142-155", "weigh