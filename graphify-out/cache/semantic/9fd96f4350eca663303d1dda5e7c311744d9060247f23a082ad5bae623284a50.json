{"nodes": [{"id": "backend_src_interview_buddy_readme_interview_buddy_module", "label": "Interview Buddy Module", "file_type": "document", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L1-L148", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_src_interview_buddy_readme_practice_mode", "label": "Practice / Consent / Live Notes Interview Modes", "file_type": "rationale", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L5-L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three modes exist to separate consent postures around audio capture: Practice captures mic freely, Consent requires explicit permission confirmation plus a visible on-screen indicator, and Live Notes avoids audio capture entirely by having the user type questions manually. Mode gates which endpoints are legal."}, {"id": "backend_src_interview_buddy_readme_sessioncontextbuilderservice", "label": "SessionContextBuilderService", "file_type": "concept", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds an immutable context pack from resume + job description + role so that coaching and scoring for a session are reproducible against a frozen snapshot rather than mutable profile data."}, {"id": "backend_src_interview_buddy_readme_coachingservice", "label": "CoachingService", "file_type": "concept", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates structured coaching output with evidence anchoring; configured separately from scoring via LLM_INTERVIEW_COACHING_* env vars at a higher temperature (0.7) because coaching is generative."}, {"id": "backend_src_interview_buddy_readme_scoringservice", "label": "ScoringService", "file_type": "concept", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scores answers against a rubric; tuned via LLM_INTERVIEW_SCORING_* at a low temperature (0.3) because scoring must be consistent rather than creative."}, {"id": "backend_src_interview_buddy_readme_interviewbuddyservice", "label": "InterviewBuddyService", "file_type": "concept", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main orchestrator for the session lifecycle (CREATED \u2192 IN_PROGRESS \u2192 COMPLETED), delegating to the context builder, coaching, and scoring services."}, {"id": "backend_src_interview_buddy_readme_sttprovider", "label": "STTProvider Interface", "file_type": "concept", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L28-L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Speech-to-text is abstracted behind an interface so development can run against MockSTTProvider without an OPENAI_API_KEY, selected at runtime via STT_PROVIDER."}, {"id": "backend_src_interview_buddy_readme_mocksttprovider", "label": "MockSTTProvider", "file_type": "concept", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_src_interview_buddy_readme_openaiwhisperbatchprovider", "label": "OpenAIWhisperBatchProvider", "file_type": "concept", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_src_interview_buddy_readme_evidence_anchoring", "label": "Evidence Anchoring", "file_type": "rationale", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L112-L118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents the LLM from inventing claims about the candidate by requiring resumeAnchorsUsed[].evidence[] in coaching output, emitting factCheck.items[] with NEEDS_USER_CONFIRMATION when uncertain, and hard-blocking when hasBlockingIssues=true and the plan depends on unsupported claims. Chooses a false-negative (block) over fabricating resume content."}, {"id": "backend_src_interview_buddy_readme_zod_validation", "label": "Zod Validation of LLM Outputs", "file_type": "rationale", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L119-L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All LLM outputs are parsed through Zod schemas shared from @jobocate/contracts (CoachingOutputSchema, ScoringOutputSchema, SessionContextPackSchema) so a malformed model response fails at the boundary rather than propagating into persisted turns."}, {"id": "backend_src_interview_buddy_readme_promptversion", "label": "PromptVersion (Versioned Prompt Templates)", "file_type": "concept", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L18-L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prompt templates live in a PromptVersion collection keyed INTERVIEW_COACHING_V1 / INTERVIEW_SCORE_V1 so prompts can be edited without a deploy; falls back to hardcoded defaults when a key is absent from the DB."}, {"id": "backend_src_interview_buddy_readme_interviewsession", "label": "InterviewSession Data Model", "file_type": "concept", "source_file": "backend/src/interview-buddy/README.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_src_interview_buddy_readme_interviewturn", "label": "InterviewTurn Data Model", "file_type": "