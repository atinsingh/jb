{"nodes": [{"id": "catalyst_ui_kit_changelog_catalyst_changelog", "label": "Catalyst UI Kit Changelog", "file_type": "document", "source_file": "catalyst-ui-kit/CHANGELOG.md", "source_location": "L1-L145", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tracks Catalyst releases from the 2023-12-20 initial release through the 2025-08-13 swap of framer-motion for motion/react and the migration to Tailwind CSS v4 / React 19 / Next.js 15.4."}, {"id": "catalyst_ui_kit_changelog_motion_react_migration", "label": "Migration from framer-motion to motion/react", "file_type": "rationale", "source_file": "catalyst-ui-kit/CHANGELOG.md", "source_location": "L3-L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "As of 2025-08-13 Catalyst imports motion/react instead of framer-motion, following the upstream package rename; the README's install line correspondingly lists `motion` rather than `framer-motion`."}, {"id": "catalyst_ui_kit_changelog_headless_ui_transition_api", "label": "Data-Attribute-Based Transition API", "file_type": "rationale", "source_file": "catalyst-ui-kit/CHANGELOG.md", "source_location": "L74-L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Headless UI v2.1 replaced render-prop transitions with data-attribute-driven ones, so Dialog, Alert, and Listbox were rewritten and `as={Fragment}` was removed from transition components."}, {"id": "catalyst_ui_kit_changelog_tailwind_v4_upgrade", "label": "Tailwind CSS v4 Upgrade Track", "file_type": "concept", "source_file": "catalyst-ui-kit/CHANGELOG.md", "source_location": "L16-L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalyst tracks the latest Tailwind closely \u2014 v4.0 on 2025-01-23, then incremental bumps to v4.0.6, v4.0.15, v4.1.3 and v4.1.4 \u2014 which is why the kit assumes the newest Tailwind rather than pinning."}], "