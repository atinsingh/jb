{"nodes": [{"id": "backend_logging_winston_logging_configuration", "label": "Winston Logging Configuration", "file_type": "document", "source_file": "backend/LOGGING.md", "source_location": "L1-L145", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_logging_apploggerservice", "label": "AppLoggerService", "file_type": "concept", "source_file": "backend/LOGGING.md", "source_location": "L47-L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implements NestJS's LoggerService interface so it can be dropped into NestJS's built-in Logger without changing call sites; context is set per-service via setContext() so logs can be traced back to the emitting module."}, {"id": "backend_logging_log_rotation", "label": "Daily Log Rotation with Compression", "file_type": "rationale", "source_file": "backend/LOGGING.md", "source_location": "L99-L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files rotate daily at midnight and are gzipped, capped at 20MB each, with automatic deletion driven by LOG_MAX_FILES. Trade-off: bounded disk usage on long-running deployments at the cost of needing decompression to read history."}, {"id": "backend_logging_structured_json_logging", "label": "Structured JSON File Logging", "file_type": "rationale", "source_file": "backend/LOGGING.md", "source_location": "L12-L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Console output is colored and human-readable for development; file output is JSON with timestamp/level/message/context so logs can be machine-parsed by aggregators. Two formats for two different consumers."}, {"id": "backend_logging_log_levels", "label": "Log Levels (error/warn/info/debug/verbose)", "file_type": "concept", "source_file": "backend/LOGGING.md", "source_location": "L27-L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "info is the production default and debug the development default, balancing signal against log volume and disk cost."}, {"id": "backend_logging_no_sensitive_data_policy", "label": "Never Log Sensitive Data Policy", "file_type": "rationale", "source_file": "backend/LOGGING.md", "source_location": "L133-L144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passwords, tokens, and PII must never be written to logs because file logs are retained for up to 30 days and shipped off-host, turning any leak into a durable one."}], "edges": [{"source": "backend_logging_apploggerservice", "target": "backend_logging_log_levels", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/LOGGING.md", "source_location": "L57-L63", "weight": 1.0}, {"source": "backend_logging_winston_logging_configuration", "target": "backend_logging_apploggerservice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/LOGGING.md", "source_location": "L49", "weight": 1.0}, {"source": "backend_logging_winston_logging_configuration", "target": "backend_logging_log_rotation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/LOGGING.md", "source_location": "L99-L104", "weight": 1.0}, {"source": "backend_logging_winston_logging_configuration", "target": "backend_logging_structured_json_logging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/LOGGING.md", "source_location": "L80-L97", "weight": 1.0}, {"source": "backend_logging_apploggerservice", "target": "backend_logging_structured_json_logging", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/LOGGING.md", "source_location": "L89-L97", "weight": 1.0}, {"source": "backend_logging_no_sensitive_data_policy", "target": "backend_logging_structured_json_logging", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "backend/LOGGING.md", "source_location": "L143", "weight": 1.0}, {"source": "backend_logging_apploggerservice", "target": "backend_nestjs_migration_dependency_injection_pattern", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/LOGGING.md", "source_location": "L51-L55", "weight": 1.0}], "hyperedges": []}