{"nodes": [{"id": "frontend_public_resume_templates_generation_guide_template_preview_generation", "label": "Resume Template Preview Generation Guide", "file_type": "document", "source_file": "frontend/public/resume-templates/GENERATION_GUIDE.md", "source_location": "L1-L159", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two paths are offered \u2014 a Puppeteer-automated screenshot run (recommended) or manual per-card downloads from the HTML generator \u2014 so previews can be regenerated without designer tooling."}, {"id": "frontend_public_resume_templates_generation_guide_adding_new_template", "label": "Adding a New Resume Template (4-Touchpoint Procedure)", "file_type": "rationale", "source_file": "frontend/public/resume-templates/GENERATION_GUIDE.md", "source_location": "L67-L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new template must be registered in four places that share the same template id: styles + markup in generate-previews.html, the TEMPLATES array in scripts/generate-all-templates.js, the templates array in src/pages/candidate/resume-builder/index.jsx, and the generated PNG. The id string is the coupling key across all of them."}, {"id": "frontend_public_resume_templates_generation_guide_image_specifications", "label": "Template Image Specifications", "file_type": "concept", "source_file": "frontend/public/resume-templates/GENERATION_GUIDE.md", "source_location": "L146-L158", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PNG at 600x800 logical (1200x1600 at 2x) matching the resume aspect ratio, 50-200KB each; Next.js optimizes them at serve time and the builder falls back to placeholders when a file is missing."}], "edges": [{"source": "frontend_public_resume_templates_generation_guide_template_preview_generation", "target": "frontend_public_resume_templates_generate_previews_generator_page", "relation":