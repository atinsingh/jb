{"nodes": [{"id": "design_claude_design_prompts_jobocate_design_prompt_pack", "label": "Jobocate Claude Design Prompt Pack", "file_type": "document", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L1-L357", "source_url": "https://claude.ai/design", "captured_at": null, "author": null, "contributor": null, "rationale": "An ordered pack of prompts for generating every remaining screen of the two-sided AI hiring marketplace in Claude Design. Prompts are pasted one at a time (each saving a .dc.html), preceded by a preamble, then handed back to Claude Code for a faithful port + backend wiring \u2014 separating design generation from implementation."}, {"id": "design_claude_design_prompts_base_preamble", "label": "Base Preamble (Candidate + Marketing)", "file_type": "rationale", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L17-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pasted once per session to pin the design system so every generated screen matches existing .dc.html files exactly; carries tokens, fonts, card/button geometry, the dc document format, and the fictional universe (Sarah Chen, Stripe 96% match, coach Marcus Bell) so data is consistent across screens."}, {"id": "design_claude_design_prompts_design_tokens", "label": "Jobocate Design Tokens", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L21-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cream canvas #F7F3EA / surface #FFFEFB / ink #1B1A16 with brand green #1FA463, deep green #157A49, mint #5BD08C and clay #C9622E for warnings. Type: Instrument Serif for display, Hanken Grotesk for UI, JetBrains Mono for labels/metrics, Bricolage Grotesque 800 for the wordmark only."}, {"id": "design_claude_design_prompts_employer_preamble", "label": "Employer Preamble", "file_type": "rationale", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L38-L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The recruiter side reuses the same design system but swaps shell and accent: EmployerSidebar instead of AppSidebar, and indigo #4263EB as the recruiter primary identity while green stays reserved for positive/success and clay for rejections. Employer universe = Dana Whitfield at Stripe on the Growth plan."}, {"id": "design_claude_design_prompts_ai_addendum", "label": "Employer AI Addendum (Agentic Principles)", "file_type": "rationale", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L46-L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Employer AI features are agentic \u2014 the AI performs activity rather than reporting analytics. Every AI action must be TRANSPARENT (shows a why), REVERSIBLE (undo), and GATED (review-first by default, full-auto only as a per-rule opt-in), with idle/working/needs-approval status states and a \u2726 sparkle + green #1FA463 visual language."}, {"id": "design_claude_design_prompts_app_shell", "label": "App Shell Pattern (Sidebar + Sticky Top Bar)", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L31-L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logged-in screens share a flex root with a sticky AppSidebar import plus a main column carrying a translucent blurred top bar; marketing screens instead import SiteNav and SiteFooter. Two shells, one token set."}, {"id": "design_claude_design_prompts_employersidebar", "label": "EmployerSidebar (E0)", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L153-L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be designed first because every other employer screen imports it; mirrors AppSidebar's mechanics (collapse 250\u21c474 persisted, mobile drawer, \u2318K palette, notifications) while swapping in recruiter nav groups HIRING/AI/ENGAGE/COMPANY and an AI-actions quota meter."}, {"id": "design_claude_design_prompts_employer_autopilot", "label": "Employer Autopilot (EA1) \u2014 AI Recruiter Cockpit", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L206-L208", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately mirrors the candidate-side App Auto-Apply so the same mental model (master switch + editable rules + review queue + undoable activity log) serves both sides of the marketplace. Rules include auto-screen & rank, auto-advance \u226585%, auto-reject <50%."}, {"id": "design_claude_design_prompts_employer_copilot", "label": "Employer Copilot (EA2)", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L209-L211", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A conversational recruiting agent that executes rather than answers: replies render ACTION CARDS with Run/Edit/Undo plus a why, gated by an 'Always ask before acting' toggle."}, {"id": "design_claude_design_prompts_employer_sourcing_agent", "label": "Employer Sourcing Agent (EA3)", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L212-L214", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Autonomous sourcing plus AI-drafted personalized outreach that stays editable before send, with an outreach queue and campaign stats."}, {"id": "design_claude_design_prompts_employer_screening", "label": "Employer Screening (EA4) \u2014 AI Auto-Screening Rubric", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L215-L217", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An editable weighted rubric derived from the JD and screening answers drives ranked applicant scores; every score expands to its reasoning, keeping the AI's ranking transparent and contestable."}, {"id": "design_claude_design_prompts_employer_ai_interview", "label": "Employer AI Interview (EA5)", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L218-L220", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Async AI-conducted screening interviews produce transcripts + competency scores + a recommendation; a second tab turns pasted notes/transcripts into a structured scorecard the recruiter confirms \u2014 AI drafts, human ratifies."}, {"id": "design_claude_design_prompts_employer_quota_reached", "label": "Employer Quota Reached (EC3) \u2014 Reusable Limit/Upsell State", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L232-L234", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One modal-able limit state is paired into Post Job, Sourcing, and Autopilot rather than reimplemented per surface; keeps an encouraging tone and always offers a non-purchase escape (Manage jobs / Close an old req)."}, {"id": "design_claude_design_prompts_backend_modules_to_build", "label": "Backend Modules Still To Build (Employer/Commercial)", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L355-L357", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outstanding: job-postings, applicants/pipeline, interviews/scorecards, offers, org/teams+roles, billing/quota/entitlement, integrations, AI recruiter service, reporting/analytics. Candidate-side resume-builder, cover-letters, interview-buddy, matching and applications already exist."}, {"id": "design_claude_design_prompts_generation_order", "label": "Recommended Generation Order", "file_type": "rationale", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L344-L353", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered candidate extras \u2192 account/system \u2192 employer (E0 first) \u2192 employer AI \u2192 commercial \u2192 marketing, because later screens import shells and reuse patterns established by earlier ones. Each group is handed back to Claude Code to import + implement + backend-wire before the next."}, {"id": "design_claude_design_prompts_app_states_reference", "label": "App States Reference Sheet (Y)", "file_type": "concept", "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L131-L133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single file rendering 404, generic error, empty list, offline/maintenance and loading-skeleton together, so reusable states are lifted from one canonical source rather than invented per screen."}], "edges": [{"source": "design_claude_design_prompts_jobocate_design_prompt_pack", "target": "design_claude_design_prompts_base_preamble", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L17-L36", "weight": 1.0}, {"source": "design_claude_design_prompts_jobocate_design_prompt_pack", "target": "design_claude_design_prompts_employer_preamble", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L38-L44", "weight": 1.0}, {"source": "design_claude_design_prompts_jobocate_design_prompt_pack", "target": "design_claude_design_prompts_ai_addendum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/CLAUDE_DESIGN_PROMPTS.md", "source_location": "L46-L49", "weight": 1.0}, {"source": "design_claude_design_prompts_base_preamble", "target": "design_clau