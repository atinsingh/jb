{"nodes": [{"id": "backend_troubleshooting_401_unauthorized_debugging", "label": "Troubleshooting 401 Unauthorized", "file_type": "document", "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L1-L112", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_troubleshooting_jwtauthguard", "label": "JwtAuthGuard", "file_type": "concept", "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L47-L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs whether a Bearer token was present and surfaces TokenExpiredError / JsonWebTokenError distinctly, so a 401 can be attributed to a missing header versus an invalid signature without attaching a debugger."}, {"id": "backend_troubleshooting_jwtstrategy", "label": "JwtStrategy", "file_type": "concept", "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L56-L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validates the JWT payload and re-looks-up the user in the database, which means a structurally valid token still 401s if the user was deleted \u2014 a deliberate trade of an extra query for revocation-on-delete."}, {"id": "backend_troubleshooting_jwt_secret_mismatch", "label": "JWT_SECRET Mismatch Failure Mode", "file_type": "rationale", "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L21-L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tokens are signed with JWT_SECRET and validated with the same value, so rotating the secret invalidates every outstanding token; default JWT_EXPIRES_IN is 7 days."}, {"id": "backend_troubleshooting_bearer_token_convention", "label": "Bearer Authorization Header Convention", "file_type": "concept", "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L13-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Header must be exactly `Authorization: Bearer <token>` with a capital B and a space; the guard does a literal prefix match."}], "edges": [{"source": "backend_troubleshooting_jwtauthguard", "target": "backend_nestjs_migration_guards_replace_auth_middleware", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L47-L70", "weight": 1.0}, {"source": "backend_troubleshooting_jwtauthguard", "target": "backend_troubleshooting_jwtstrategy", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L47-L70", "weight": 1.0}, {"source": "backend_troubleshooting_jwtauthguard", "target": "backend_troubleshooting_bearer_token_convention", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L13-L19", "weight": 1.0}, {"source": "backend_troubleshooting_jwtstrategy", "target": "backend_troubleshooting_jwt_secret_mismatch", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L21-L27", "weight": 1.0}, {"source": "backend_troubleshooting_401_unauthorized_debugging", "target": "backend_troubleshooting_jwtauthguard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L49", "weight": 1.0}, {"source": "backend_troubleshooting_401_unauthorized_debugging", "target": "backend_troubleshooting_jwtstrategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/TROUBLESHOOTING.md", "source_location": "L58", "weight": 1.0}, {"source": "backend_troubleshooting_401_unauthorized_debugging", "target": "backend_nestjs_migration_auth_module", "relation": "conceptually_related_to", "confidence