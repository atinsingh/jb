{"nodes": [{"id": "visual_guide_split_screen_editor_layout", "label": "Split-Screen Editor Layout (Visual Guide)", "file_type": "concept", "source_file": "VISUAL_GUIDE.md", "source_location": "lines 54-134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ASCII wireframes of the editor: Content/Design tabs, left editing panel of collapsible section cards (Personal Info, Summary, Experience, Education, Skills, Projects) and right live-preview panel; the Design tab mutates colors/size/spacing/font with the preview updating in real time."}, {"id": "visual_guide_ux_patterns", "label": "Editor UX Patterns", "file_type": "concept", "source_file": "VISUAL_GUIDE.md", "source_location": "lines 136-190", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five recurring patterns: collapsible section cards with header actions, click-to-edit inline fields with Save/Cancel, hover-revealed item card actions, a prominent 'Generate with AI' button per editor, and an auto-save indicator that shows 'Saving...' then 'All changes saved'."}, {"id": "visual_guide_responsive_breakpoints", "label": "Responsive Breakpoints", "file_type": "concept", "source_file": "VISUAL_GUIDE.md", "source_location": "lines 209-226", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktop 1024px+ shows full split screen at 40% editor / 60% preview; tablet 768-1023px stacks editor above a collapsible preview; mobile <768px is single column with tabs to switch panes and touch-optimized controls."}, {"id": "visual_guide_pdf_generation_flow", "label": "PDF Generation Flow (Visual Guide)", "file_type": "concept", "source_file": "VISUAL_GUIDE.md", "source_location": "lines 263-283", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Download PDF -> backend request -> Puppeteer launches -> navigate to /resume/preview/:id -> page signals ready -> capture A4 high-res -> save to server -> return download URL -> user downloads."}, {"id": "visual_guide_keyboard_navigation", "label": "Editor Keyboard Navigation Map", "file_type": "concept", "source_file": "VISUAL_GUIDE.md", "source_location": "lines 247-255", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tab/Shift+Tab move between fields, Enter edits a section, Escape cancels editing, Space toggles a section, arrow keys navigate lists."}], "edges": [{"source": "visual_guide_split_screen_editor_layout", "target": "resume_builder_redesign_modernresumeeditor", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "VISUAL_GUIDE.md", "source_location": "lines 54-134", "weight": 1.0}, {"source": "visual_guide_split_screen_editor_layout", "target": "resume_builder_redesign_design_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VISUAL_GUIDE.md", "source_location": "lines 102-134, 192-207", "weight": 1.0}, {"source": "visual_guide_ux_patterns", "target": "visual_guide_split_screen_editor_layout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VISUAL_GUIDE.md", "source_location": "lines 136-190", "weight": 1.0}, {"source": "visual_guide_ux_patterns", "target": "resume_builder_redesign_debounced_autosave", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VISUAL_GUIDE.md", "source_location": "lines 183-190, 286-292", "weight": 1.0}, {"source": "visual_guide_ux_patterns", "target": "resume_builder_redesign_ai_content_tools", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VISUAL_GUIDE.md", "source_location": "lines 171-181", "weight": 1.0}, {"source": "visual_guide_pdf_generation_flow", "target": "resume_builder_redesign_pdf_service", "relation": "references", "confidence": "INFERRED", "confi