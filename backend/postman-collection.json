          }
        },
        {
          "name": "Liveness",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/live",
              "host": ["{{baseUrl}}"],
              "path": ["live"]
            }
          }
        }
      ]
    }
  ]
}

