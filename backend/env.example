# Server
NODE_ENV=development
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/jobocate

# Supabase (auth). The service-role key BYPASSES ALL AUTHORISATION — it is
# backend-only and must never appear in a NEXT_PUBLIC_* var or the browser bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# A shared secret YOU generate (openssl rand -base64 32), not one Supabase issues.
# Database Webhooks are Postgres triggers calling pg_net and have no built-in
# signature scheme, so the same value goes in the webhook custom header and here.
SUPABASE_WEBHOOK_SECRET=generate-your-own-shared-secret

# Signs short-lived PDF-render/share tokens in resume-builder. NOT user auth —
# kept separate from JWT_SECRET precisely so the Supabase cutover can retire
# JWT_SECRET without silently breaking PDF rendering.
RESUME_SHARE_SECRET=your-resume-share-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Rate Limiting
THROTTLE_LIMIT_SHORT=10
THROTTLE_LIMIT_MEDIUM=50
THROTTLE_LIMIT_LONG=200

# Logging
LOG_LEVEL=debug

# Swagger (optional in production)
SWAGGER_ENABLED=true

# Redis (for production with BullMQ)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
