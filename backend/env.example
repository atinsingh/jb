# Server
NODE_ENV=development
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/jobocate

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Supabase (auth). The service-role key BYPASSES ALL AUTHORISATION — it is
# backend-only and must never appear in a NEXT_PUBLIC_* var or the browser bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_WEBHOOK_SECRET=your-database-webhook-signing-secret

# Signs short-lived PDF-render/share tokens in resume-builder. NOT user auth —
# kept separate from JWT_SECRET precisely so the Supabase cutover can retire
# JWT_SECRET without silently breaking PDF rendering.
RESUME_SHARE_SECRET=your-resume-share-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# LinkedIn OAuth (optional)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Rate Limiting
THROTTLE_LIMIT_SHORT=10
THROTTLE_LIMIT_MEDIUM=50
THROTTLE_LIMIT_LONG=200

# Logging
LOG_LEVEL=debug

# Swagger (optional in production)
SWAGGER_ENABLED=true

# Redis (for production with BullMQ)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
