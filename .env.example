# =============================================================================
# Jobocate — the one environment file.
#
# Copy to `.env.local` and fill in. Everything reads from that single file:
# the NestJS backend, the Next.js frontend, both compose stacks, the Playwright
# suite and the CLI scripts. There are no per-app env files any more — if you
# find yourself creating `backend/.env` or `frontend/.env.local`, something has
# regressed.
#
#   cp .env.example .env.local
#
# Precedence everywhere: real process env  >  .env.local  >  .env
# (dotenv never overwrites a variable that is already exported, so CI and
# compose can override any line below without editing this file.)
#
# ── Write values UNQUOTED ────────────────────────────────────────────────────
# This file is read by two different parsers with different rules. dotenv (Node)
# strips surrounding quotes; Docker's `--env-file` / compose `env_file` does
# NOT — it takes the rest of the line literally. So `KEY="abc"` reaches the app
# as abc but reaches a container as "abc", quotes included, and the failure
# shows up as a puzzling 403 from whatever service the key belongs to.
# Leave off the quotes and both agree. No spaces around `=`, either.
#
# ── The one rule that matters ────────────────────────────────────────────────
# Anything prefixed NEXT_PUBLIC_ is INLINED INTO THE BROWSER BUNDLE and is
# world-readable. Everything else stays server-side. Putting a secret behind a
# NEXT_PUBLIC_ name publishes it. In particular SUPABASE_SERVICE_ROLE_KEY
# bypasses all authorisation — it must never gain that prefix.
# =============================================================================


# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Host default is 27017. This machine runs Mongo on 27018 — match whichever
# port `docker ps` actually shows. Inside compose the host is `mongodb`.
MONGODB_URI=mongodb://localhost:27017/jobocate

# ── Supabase (auth) ──────────────────────────────────────────────────────────
# The service-role key BYPASSES ALL AUTHORISATION — backend only, never
# NEXT_PUBLIC_. The anon key is public by design and is safe to expose.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# A shared secret YOU generate (`openssl rand -base64 32`), not one Supabase
# issues. Database Webhooks are Postgres triggers calling pg_net and have no
# built-in signature scheme, so the same value goes in the webhook custom
# header and here.
SUPABASE_WEBHOOK_SECRET=generate-your-own-shared-secret

# Browser-side Supabase. Same project as above; the anon key is the public one.
# The Playwright suite reads these to provision its test users.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── URLs ─────────────────────────────────────────────────────────────────────
# FRONTEND_URL is the single origin used for links the backend generates.
# Extra browser origins (e.g. a dev server on :3001) go in CORS_EXTRA_ORIGINS.
FRONTEND_URL=http://localhost:3000
# CORS_EXTRA_ORIGINS=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
# Legacy alias for NEXT_PUBLIC_API_URL, still read by older frontend modules.
REACT_APP_BACKEND_URL=http://localhost:8000

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signs short-lived PDF-render/share tokens in resume-builder. NOT user auth —
# kept separate so the Supabase cutover can retire JWT_SECRET without silently
# breaking PDF rendering.
RESUME_SHARE_SECRET=your-resume-share-secret

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_LIMIT_SHORT=10
THROTTLE_LIMIT_MEDIUM=50
THROTTLE_LIMIT_LONG=200

# ── Logging / docs ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# ── Queues (optional; BullMQ) ────────────────────────────────────────────────
# QUEUE_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=


# =============================================================================
# Resume harness (JOB-98) — LaTeX résumé generation via Claude Code / Codex /
# OpenCode, one sandbox per session, everything routed through LiteLLM.
#
# Metered platform keys only. Claude Pro/Max and ChatGPT Plus/Pro logins are
# Consumer Terms products; nothing here enables them, and a unit test fails if
# such a path is ever added.
# =============================================================================

# The proxy every harness talks to (aliases live in infra/litellm/config.yaml).
LITELLM_BASE_URL=http://localhost:4000
# A LiteLLM *virtual* key — this is what each sandbox is handed. Not the master.
RESUME_HARNESS_LITELLM_KEY=
# Master key for the proxy itself; used by the compose service, not by sandboxes.
LITELLM_MASTER_KEY=sk-litellm-dev-master
# Optional: Postgres URL for LiteLLM's spend logs (per-harness usage reporting).
LITELLM_DATABASE_URL=

# ── Sandboxes ────────────────────────────────────────────────────────────────
# Which backend runs the harnesses:
#   docker         - local Docker daemon (default; the one that works)
#   agent-platform - self-hosted LiteLLM Agent Platform (publishes no image and
#                    has no documented sandbox API; its client is unverified)
RESUME_SANDBOX_DRIVER=docker

# The Docker network sandboxes join. MUST be the network the LiteLLM proxy is
# on — `docker inspect jobocate-litellm --format '{{range $k,$v :=
# .NetworkSettings.Networks}}{{$k}}{{end}}'` prints it. On the default bridge
# the harness cannot reach a model at all.
RESUME_SANDBOX_NETWORK=jb_jobocate-network

# The proxy URL as seen FROM INSIDE a sandbox — a service name, not localhost,
# which inside a container is the container itself.
RESUME_HARNESS_LITELLM_INTERNAL_URL=http://jobocate-litellm:4000

# Only read when RESUME_SANDBOX_DRIVER=agent-platform.
AGENT_PLATFORM_URL=http://localhost:4100
AGENT_PLATFORM_API_KEY=
RESUME_SANDBOX_IMAGE=jobocate/resume-harness:latest
RESUME_SANDBOX_TTL_SECONDS=3600

# ── Model providers behind the proxy ─────────────────────────────────────────
# Set whichever you actually have; the proxy only serves aliases whose provider
# is configured, and `harness_model_aliases` decides which tiers may pick them.

# Anthropic Console (Commercial Terms).
ANTHROPIC_API_KEY=
# OpenAI Platform.
OPENAI_API_KEY=
# Amazon Bedrock — IAM credentials.
#
# Required for the agentic harnesses. Only LiteLLM's Converse route emits
# streaming tool-call ids, and only IAM auth reaches Converse; the Bedrock API
# key below is forced onto the invoke route, which omits those ids and breaks
# every tool call. The long note in infra/litellm/config.yaml has the detail.
#
# Needs just bedrock:InvokeModel and bedrock:InvokeModelWithResponseStream.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock API key (a bearer token). Still used by the credential check:
#   cd backend && npm run harness:bedrock-check
# Fine for plain completions; not sufficient to drive a harness.
AWS_BEARER_TOKEN_BEDROCK=

# Must be a region the credentials are entitled to AND the model is enabled in.
AWS_REGION=us-east-1


# =============================================================================
# Optional — every variable below is READ BY THE CODE but has a working default,
# so the app boots without them. They are listed (commented out) so this file
# stays the complete reference: if a var is not here, the code does not read it.
#
# Uncomment and set only what you need. A commented line is NOT a default being
# applied — the default lives in the code.
# =============================================================================

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Without these, outbound email is disabled — it fails quietly rather than
# blocking a request, so a missing SMTP_HOST looks like "no email was sent".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Jobocate <no-reply@example.com>
# LEADS_NOTIFY_EMAIL=

# ── Extra LLM providers / routing ────────────────────────────────────────────
# The resume harness uses the LiteLLM block above. These drive the OTHER AI
# features (matching, cover letters, interview coaching) via LLMRoutingService.
# AI_PROVIDER=
# LLM_DEFAULT_PROVIDER=openai
# LLM_DEFAULT_MODEL=
# EMERGENT_LLM_KEY=
# LITELLM_API_KEY=
# LITELLM_MODEL=
# LITELLM_TOOLS_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# OPENROUTER_MODEL=
# OPENROUTER_FALLBACK_MODELS=
# OPENROUTER_APP_NAME=
# OPENROUTER_SITE_URL=
# Speech-to-text, used by the live-interview surface.
# STT_PROVIDER=
# STT_API_KEY=

# ── Job ingestion / scraping ─────────────────────────────────────────────────
# JOB_SCRAPING_ENABLED=false
# MAX_JOBS_PER_SCRAPE=
# GREENHOUSE_BOARDS=
# LEVER_BOARDS=
# WORKDAY_SITES=
# WORKDAY_DOMAIN=
# WORKDAY_FETCH_DETAILS=false
# WORKDAY_DETAIL_TIMEOUT_MS=
# MONITORS_CRON_DISABLE=false
# MONITORS_SYSTEM_USER_ID=
# PUPPETEER_EXECUTABLE_PATH=

# ── Auto-apply guardrails ────────────────────────────────────────────────────
# Nothing is ever submitted without candidate approval; these bound the runner.
# AUTO_APPLICATION_ENABLED=false
# AUTO_PREPARE_ENABLED=false
# MAX_APPLICATIONS_PER_DAY=
# MIN_MATCH_SCORE_FOR_AUTO_APPLY=
# MAX_UNREVIEWED_PREPARES=
# DRY_RUN_COVERAGE_BAR=
# FILL_COVERAGE_ALARM=

# ── Storage & logging ────────────────────────────────────────────────────────
# LOCAL_STORAGE_PATH=
# STORAGE_LOCAL_PATH=
# LOGS_DIR=
# LOG_FILE=false
# LOG_CONSOLE=true
# LOG_MAX_FILES=

# ── Docker-internal ──────────────────────────────────────────────────────────
# Set as a compose `environment:` override, not here — it only makes sense
# inside the compose network.
# INTERNAL_FRONTEND_URL=http://frontend:3000
